import { useMemo, useRef, useState } from 'react'
import { useAuth, useChannels, useMessages, useMutations, useQuery, useUserLookup } from 'deepspace'
import { demoCsv, reconcileCsv, type InventoryException, type ParseFailure } from '../../../domain/reconciliation'

type CaseStatus = 'open' | 'investigating' | 'resolved'
type CaseData = InventoryException & { status: CaseStatus; assignee: string; resolution: string }
type NoteData = { exceptionId: string; body: string }
type Stored<T> = { recordId: string; createdAt: string; createdBy: string; data: T }

const issueNames: Record<InventoryException['type'], string> = {
  MISSING_SKU: 'Missing identifier',
  NEGATIVE_STOCK: 'Negative stock',
  QUANTITY_MISMATCH: 'Quantity mismatch',
}

const format = (value: number) => new Intl.NumberFormat('en-US').format(value)

function TeamChat({ channelId }: { channelId: string }) {
  const { messages, send } = useMessages(channelId)
  const [draft, setDraft] = useState('')
  const lookup = useUserLookup()
  return <div className="flex h-full min-h-0 flex-col">
    <div className="flex-1 space-y-4 overflow-auto px-5 py-5">
      {messages.length === 0 && <p className="text-sm text-slate-500">No team messages yet. Start the conversation.</p>}
      {messages.map((message) => <div key={message.recordId} className="space-y-1"><div className="flex items-center gap-2 text-xs text-slate-500"><span className="font-semibold text-slate-700">{lookup.getName(message.data.authorId) || 'Teammate'}</span><span>{new Date(message.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span></div><p className="break-words text-sm text-slate-700">{message.data.content}</p></div>)}
    </div>
    <form className="flex gap-2 border-t border-slate-200 p-4" onSubmit={(event) => { event.preventDefault(); if (!draft.trim()) return; send(draft.trim()); setDraft('') }}><input aria-label="Team message" className="min-w-0 flex-1 rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-teal-500" placeholder="Message your team" value={draft} maxLength={1000} onChange={(event) => setDraft(event.target.value)} /><button className="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Send</button></form>
  </div>
}

function CollaborationPanel() {
  const { channels, create } = useChannels()
  const [pending, setPending] = useState(false)
  const [error, setError] = useState('')
  const channel = channels.find((record) => record.data.name === 'stockroom-operations')
  return <section className="flex h-[420px] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div className="border-b border-slate-100 px-5 py-4"><h2 className="font-semibold text-slate-900">Operations channel</h2><p className="mt-1 text-xs text-slate-500">Live team messaging · shared across signed-in users</p></div>{channel ? <TeamChat channelId={channel.recordId} /> : <div className="flex flex-1 flex-col items-center justify-center gap-3 p-6 text-center"><p className="text-sm text-slate-500">Create the shared discussion channel for exception triage.</p>{error && <p role="alert" className="text-sm text-rose-600">{error}</p>}<button disabled={pending} className="rounded-xl bg-teal-600 px-4 py-2 text-sm font-semibold text-white disabled:opacity-50" onClick={async () => { setPending(true); setError(''); try { await create({ name: 'stockroom-operations', description: 'Inventory triage and handoff' }) } catch (cause) { setError(cause instanceof Error ? cause.message : 'Unable to create channel') } finally { setPending(false) } }}>{pending ? 'Creating…' : 'Create team channel'}</button></div>}</section>
}

function CaseDetail({ item, notes, onClose, onUpdate, onAddNote }: { item: Stored<CaseData>; notes: Stored<NoteData>[]; onClose: () => void; onUpdate: (patch: Partial<CaseData>) => void; onAddNote: (body: string) => Promise<void> }) {
  const [draft, setDraft] = useState('')
  const [resolution, setResolution] = useState(item.data.resolution || '')
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState('')
  const lookup = useUserLookup()
  return <div className="fixed inset-0 z-40 flex justify-end bg-slate-950/40" onClick={onClose}><div role="dialog" aria-modal="true" aria-label="Exception investigation" className="flex h-full w-full max-w-xl flex-col bg-white shadow-2xl" onClick={(event) => event.stopPropagation()}><div className="flex items-start justify-between border-b border-slate-200 p-6"><div><p className="text-xs font-bold uppercase tracking-widest text-teal-700">Investigation · {item.data.warehouse}</p><h2 className="mt-2 text-xl font-bold text-slate-900">{item.data.product}</h2><p className="mt-1 font-mono text-xs text-slate-500">{item.data.sku || 'SKU missing'} · {issueNames[item.data.type]}</p></div><button aria-label="Close investigation" onClick={onClose} className="rounded-lg border border-slate-200 px-3 py-2 text-sm">Close</button></div><div className="flex-1 space-y-6 overflow-auto p-6"><div className="grid grid-cols-3 gap-3">{[['Expected',item.data.expected],['Counted',item.data.counted],['Variance',item.data.variance]].map(([label,value])=><div key={label} className="rounded-xl bg-slate-50 p-4"><p className="text-xs text-slate-500">{label}</p><p className="mt-1 text-xl font-bold tabular-nums text-slate-900">{format(Number(value))}</p></div>)}</div><div><p className="mb-2 text-sm font-semibold text-slate-800">Investigation status</p><div className="grid grid-cols-3 gap-2">{(['open','investigating','resolved'] as CaseStatus[]).map((status)=><button key={status} onClick={()=>onUpdate({ status })} className={`rounded-xl border px-2 py-3 text-xs font-semibold capitalize ${item.data.status===status?'border-teal-700 bg-teal-50 text-teal-800':'border-slate-200 text-slate-500'}`}>{status}</button>)}</div></div><div><label className="mb-2 block text-sm font-semibold text-slate-800">Resolution summary</label><textarea className="min-h-24 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-teal-500" maxLength={1500} value={resolution} onChange={(event)=>setResolution(event.target.value)} placeholder="What was checked and what action was taken?"/><button className="mt-2 rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white" onClick={()=>onUpdate({resolution})}>Save resolution</button></div><div><h3 className="mb-4 text-sm font-semibold text-slate-800">Investigation history</h3><div className="space-y-3">{notes.length===0&&<p className="text-sm text-slate-500">Add the first investigation note.</p>}{notes.map((note)=><div key={note.recordId} className="rounded-xl border border-slate-200 p-4"><div className="mb-2 flex justify-between gap-2 text-xs text-slate-500"><span>{lookup.getName(note.createdBy) || 'Team member'}</span><time>{new Date(note.createdAt).toLocaleString()}</time></div><p className="whitespace-pre-wrap break-words text-sm text-slate-700">{note.data.body}</p></div>)}</div></div></div><form className="border-t border-slate-200 p-5" onSubmit={async (event)=>{event.preventDefault();if(!draft.trim())return;setBusy(true);setError('');try{await onAddNote(draft.trim());setDraft('')}catch(cause){setError(cause instanceof Error?cause.message:'Unable to save note')}finally{setBusy(false)}}}><label className="mb-2 block text-sm font-semibold text-slate-800">Add an investigation note</label><textarea maxLength={1500} className="min-h-20 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-teal-500" value={draft} onChange={(event)=>setDraft(event.target.value)} placeholder="Record evidence, next steps, or a decision"/>{error&&<p role="alert" className="text-xs text-rose-600">{error}</p>}<button disabled={busy||!draft.trim()} className="mt-2 w-full rounded-xl bg-teal-600 py-3 text-sm font-semibold text-white disabled:opacity-50">{busy?'Saving…':'Add note'}</button></form></div></div>
}

export default function StockroomPage() {
  const { userId } = useAuth()
  const { records, status } = useQuery<CaseData>('inventory-exceptions', { orderBy: 'createdAt' })
  const { records: notes } = useQuery<NoteData>('investigation-notes', { orderBy: 'createdAt' })
  const { create, put } = useMutations<CaseData>('inventory-exceptions')
  const noteMutations = useMutations<NoteData>('investigation-notes')
  const fileRef = useRef<HTMLInputElement>(null)
  const [selectedId, setSelectedId] = useState<string | null>(null)
  const [search, setSearch] = useState('')
  const [filter, setFilter] = useState<'all' | CaseStatus>('all')
  const [errors, setErrors] = useState<ParseFailure[]>([])
  const [notice, setNotice] = useState('')
  const [busy, setBusy] = useState(false)
  const selected = records.find((record)=>record.recordId===selectedId) as Stored<CaseData> | undefined
  const visible = useMemo(()=>records.filter((record)=>{
    const match = [record.data.sku,record.data.product,record.data.warehouse,record.data.type].join(' ').toLowerCase().includes(search.toLowerCase())
    return match && (filter==='all'||record.data.status===filter)
  }),[records,search,filter])
  const open = records.filter((record)=>record.data.status!=='resolved').length
  const critical = records.filter((record)=>record.data.severity==='critical'&&record.data.status!=='resolved').length
  const resolved = records.filter((record)=>record.data.status==='resolved').length
  const importCsv = async (source: string)=>{
    setBusy(true);setNotice('');setErrors([])
    try {
      const result = reconcileCsv(source)
      setErrors(result.errors)
      const existing = new Set(records.map((record)=>record.data.fingerprint))
      let imported = 0
      let duplicate = 0
      let failed = 0
      for(const issue of result.exceptions){
        if(existing.has(issue.fingerprint)){duplicate+=1;continue}
        try { await create({...issue,status:'open',assignee:'',resolution:''});existing.add(issue.fingerprint);imported+=1 }
        catch {failed+=1}
      }
      setNotice(`${imported} exceptions created · ${duplicate} already tracked · ${failed} writes failed · ${result.errors.length} rejected rows`)
    }catch(cause){setNotice(cause instanceof Error?cause.message:'Import failed')}
    finally{setBusy(false)}
  }
  return <div className="min-h-screen bg-[#f5f7f7] text-slate-900"><header className="border-b border-slate-200 bg-white"><div className="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8"><div className="flex items-center gap-3"><div className="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-700 text-lg font-black text-white">S</div><div><p className="text-base font-extrabold tracking-tight">Stockroom <span className="text-teal-700">Pulse</span></p><p className="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-400">Inventory intelligence</p></div></div><div className="flex items-center gap-2 text-xs text-slate-500"><span className="h-2 w-2 rounded-full bg-emerald-500"/>DeepSpace workspace<span className="ml-2 hidden rounded-full bg-slate-100 px-3 py-1.5 font-mono text-slate-600 sm:block">{userId?.slice(0,8)||'signed in'}</span></div></div></header><main className="mx-auto max-w-7xl space-y-7 px-5 py-9 lg:px-8"><div className="flex flex-wrap items-end justify-between gap-4"><div><p className="text-xs font-bold uppercase tracking-[0.2em] text-teal-700">Operations overview</p><h1 className="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Exception command center</h1><p className="mt-2 text-sm text-slate-500">Detect discrepancies, investigate collaboratively, and close the loop.</p></div><div className="flex gap-2"><input ref={fileRef} type="file" accept=".csv,text/csv" className="hidden" aria-label="Select inventory CSV" onChange={async(event)=>{const file=event.target.files?.[0];if(file){if(file.size>500000){setNotice('CSV must be smaller than 500 KB')}else await importCsv(await file.text())}event.target.value=''}}/><button disabled={busy} onClick={()=>void importCsv(demoCsv)} className="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold shadow-sm disabled:opacity-50">Load demo data</button><button disabled={busy} onClick={()=>fileRef.current?.click()} className="rounded-xl bg-teal-700 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-teal-800 disabled:opacity-50">{busy?'Processing…':'Import CSV'}</button></div></div>{notice&&<div role="status" className="rounded-xl border border-teal-200 bg-teal-50 p-4 text-sm text-teal-900">{notice}</div>}{errors.length>0&&<div className="rounded-xl border border-amber-200 bg-amber-50 p-4"><p className="font-semibold text-amber-900">Rejected rows ({errors.length})</p><div className="mt-2 max-h-32 overflow-auto text-xs text-amber-800">{errors.slice(0,30).map((error)=><p key={error.row}>Row {error.row}: {error.reason}</p>)}</div></div>}<div className="grid gap-4 sm:grid-cols-3">{[{label:'Active investigations',value:open,detail:'Require review',mark:'bg-teal-50 text-teal-700'},{label:'Critical exceptions',value:critical,detail:'Prioritize immediately',mark:'bg-rose-50 text-rose-700'},{label:'Resolved issues',value:resolved,detail:'Documented and closed',mark:'bg-emerald-50 text-emerald-700'}].map((metric)=><section key={metric.label} className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><p className="text-sm font-semibold text-slate-500">{metric.label}</p><p className="mt-3 text-4xl font-extrabold tabular-nums">{format(metric.value)}</p><span className={`mt-4 inline-flex rounded-full px-3 py-1 text-xs font-semibold ${metric.mark}`}>{metric.detail}</span></section>)}</div><div className="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]"><section className="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5"><div><h2 className="font-bold">Exception queue</h2><p className="mt-1 text-xs text-slate-500">{visible.length} visible · real-time shared records</p></div><div className="flex flex-wrap gap-2"><input aria-label="Search exceptions" placeholder="Search SKU or product" value={search} onChange={(event)=>setSearch(event.target.value)} className="w-44 rounded-lg border border-slate-200 px-3 py-2 text-xs outline-none focus:border-teal-500"/><select aria-label="Filter by status" value={filter} onChange={(event)=>setFilter(event.target.value as typeof filter)} className="rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs"><option value="all">All statuses</option><option value="open">Open</option><option value="investigating">Investigating</option><option value="resolved">Resolved</option></select></div></div><div className="overflow-x-auto"><table className="w-full min-w-[630px] text-left"><thead className="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500"><tr><th className="px-5 py-4">Product / SKU</th><th className="px-3 py-4">Issue</th><th className="px-3 py-4">Variance</th><th className="px-3 py-4">Priority</th><th className="px-3 py-4">Status</th><th className="px-3 py-4"></th></tr></thead><tbody className="divide-y divide-slate-100">{status==='loading'&&<tr><td colSpan={6} className="px-5 py-12 text-center text-sm text-slate-500">Loading workspace…</td></tr>}{status!=='loading'&&visible.length===0&&<tr><td colSpan={6} className="px-5 py-16 text-center text-sm text-slate-500">No matching exceptions. Load synthetic demo data to begin.</td></tr>}{visible.map((record)=><tr key={record.recordId} className="hover:bg-slate-50"><td className="px-5 py-4"><p className="text-sm font-semibold">{record.data.product}</p><p className="mt-1 font-mono text-xs text-slate-400">{record.data.sku||'UNLABELED'} · {record.data.warehouse}</p></td><td className="px-3 py-4 text-xs text-slate-600">{issueNames[record.data.type]}</td><td className={`px-3 py-4 font-mono text-sm font-bold ${record.data.variance<0?'text-rose-700':'text-slate-700'}`}>{record.data.variance>0?'+':''}{record.data.variance}</td><td className="px-3 py-4"><span className={`rounded-full px-2.5 py-1 text-[11px] font-semibold capitalize ${record.data.severity==='critical'?'bg-rose-100 text-rose-700':record.data.severity==='high'?'bg-orange-100 text-orange-700':'bg-amber-100 text-amber-800'}`}>{record.data.severity}</span></td><td className="px-3 py-4 text-xs font-medium capitalize text-slate-600">{record.data.status}</td><td className="px-3 py-4"><button onClick={()=>setSelectedId(record.recordId)} className="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold hover:border-teal-500">Review</button></td></tr>)}</tbody></table></div></section><div className="space-y-5"><CollaborationPanel/><section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 className="font-semibold">Import contract</h2><p className="mt-2 text-sm leading-6 text-slate-500">Use a UTF-8 CSV with columns <span className="font-mono text-slate-700">sku, product, expected, counted, warehouse</span>. Each import accepts at most 1,000 rows. Duplicate issues are skipped; existing investigations remain intact.</p><a className="mt-3 inline-block text-sm font-semibold text-teal-700 underline underline-offset-4" href={`data:text/csv;charset=utf-8,${encodeURIComponent(demoCsv)}`} download="stockroom-demo.csv">Download sample CSV</a></section></div></div></main>{selected&&<CaseDetail key={selected.recordId} item={selected} notes={notes.filter((note)=>note.data.exceptionId===selected.recordId) as Stored<NoteData>[]} onClose={()=>setSelectedId(null)} onUpdate={(patch)=>put(selected.recordId,patch)} onAddNote={async(body)=>{await noteMutations.create({exceptionId:selected.recordId,body})}}/>}</div>
}
